{
  "name": "BlueSphere Marine Monitoring Platform",
  "short_name": "BlueSphere",
  "description": "Advanced marine monitoring and shark tracking platform for ocean conservation",
  "version": "1.0.0",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0ea5e9",
  "theme_color": "#0284c7",
  "orientation": "any",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "science", "conservation"],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Shark Tracking",
      "short_name": "Sharks",
      "description": "Track sharks in real-time",
      "url": "/sharks",
      "icons": [
        {
          "src": "/icons/shortcut-sharks.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Interactive Maps",
      "short_name": "Maps",
      "description": "Explore ocean data",
      "url": "/mapping",
      "icons": [
        {
          "src": "/icons/shortcut-maps.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Marine Analytics",
      "short_name": "Analytics",
      "description": "Ocean health analysis",
      "url": "/analytics",
      "icons": [
        {
          "src": "/icons/shortcut-analytics.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Marine Alerts",
      "short_name": "Alerts",
      "description": "Critical marine alerts",
      "url": "/alerts",
      "icons": [
        {
          "src": "/icons/shortcut-alerts.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "marine_data",
          "accept": [".json", ".csv", ".kml"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+bluesphere",
      "url": "/handle?data=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "capture_links": "existing-client-navigate",
  "display_override": ["window-controls-overlay", "minimal-ui", "browser"],
  "prefer_related_applications": false
}